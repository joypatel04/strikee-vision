# ---- Auth (simple: one shared login) ----
APP_USERNAME=admin
APP_PASSWORD=change-me-strong
# 32+ random chars used to sign the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# How long a login stays valid before re-login (days). Default 30.
SESSION_DAYS=30

# ---- Tracking data (Turso / libSQL, read) ----
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# ---- Strikee POS (Supabase, server-side only) ----
SUPABASE_URL=https://agqnqwispnaytefftgpe.supabase.co
# Service role key — SERVER ONLY, never exposed to the browser. Lets us read
# game_sessions directly (bypasses RLS) to compute billed games/revenue.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Venue mapping ----
# Your Strikee snooker club shop id.
STRIKEE_SHOP_ID=36
# Optional: the tracking venue id in Turso (if you run more than one venue).
STRIKEE_VENUE_ID=
