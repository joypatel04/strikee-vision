# Strikee Vision - venue box settings.
#
# Copy to `.env` beside strikee.db and it is loaded every time the app starts,
# from any shell, shortcut or scheduled task. A real environment variable still
# wins, so `set VAR=x` remains a per-run override while you tune.
#
# Confirm it was picked up: dashboard -> System check -> the From column should
# read "env file" for anything you set here.

# --- capture -----------------------------------------------------------------
# Concurrent DVR connections, shared by all venues. 4 was measured to drop.
STRIKEE_MAX_STREAMS=2
STRIKEE_RATE_TABLE=13
STRIKEE_RATE_GAMING=5
STRIKEE_RATE_ENTRY=3

# --- occupancy timing --------------------------------------------------------
# In SECONDS, converted per asset from its own sampling rate. Prefer these over
# the *_TICKS knobs, which mean different durations at different rates.
STRIKEE_EXIT_SEC=120
# STRIKEE_ENTER_SEC=25
# STRIKEE_STILL_SEC=40

# --- models ------------------------------------------------------------------
# STRIKEE_SNOOKER_MODEL=best.pt
# STRIKEE_PERSON_MODEL=yolo11n.pt

# --- storage -----------------------------------------------------------------
# STRIKEE_DB=strikee.db
# STRIKEE_SNAPSHOT_DIR=snapshots
# Writes debug_<venue>.csv - one row per read per asset. On for a field test.
STRIKEE_DEBUG=1

# --- cloud sync (Turso) ------------------------------------------------------
# Needs: pip install -e ".[turso]"
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token-here
# STRIKEE_TURSO_SYNC_SEC=15

# --- object storage (S3 / Cloudflare R2) -------------------------------------
# Needs: pip install -e ".[cloud]"
#
# TWO SEPARATE THINGS, and you probably want only the first:
#
#   STRIKEE_S3_BUCKET      evidence SNAPSHOTS - the game-start images. Local
#                          copies always exist; this puts them somewhere the
#                          reconciliation app can show them from anywhere.
#   STRIKEE_BACKUP_BUCKET  the whole DATABASE, on a timer. Redundant if Turso
#                          sync is on, since that already keeps a cloud copy.
#
# THE ENDPOINT IS NOT OPTIONAL FOR R2. Without it boto3 talks to Amazon S3, and
# your R2 bucket name means nothing there. Find it in the Cloudflare dashboard:
# R2 -> your bucket -> Settings -> S3 API. It looks like:
#   https://<32-hex-account-id>.r2.cloudflarestorage.com
# Region stays "auto" for R2.
#
# STRIKEE_S3_BUCKET=strikee-snapshots
# STRIKEE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STRIKEE_S3_REGION=auto
#
# STRIKEE_BACKUP_BUCKET=strikee
# STRIKEE_BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STRIKEE_BACKUP_REGION=auto
# STRIKEE_BACKUP_EVERY_MIN=10
#
# Credentials: create an R2 API token with Object Read & Write.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- unattended run ----------------------------------------------------------
# Start tracking on boot with no clicks. "all" starts every venue.
# STRIKEE_AUTOSTART_VENUE=all
# STRIKEE_HEADLESS=1
