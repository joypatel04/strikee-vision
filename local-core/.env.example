# Strikee Vision - venue box settings.
#
# Copy to `.env` beside strikee.db and it is loaded every time the app starts,
# from any shell, shortcut or scheduled task. A real environment variable still
# wins, so `set VAR=x` remains a per-run override while you tune.
#
# Confirm it was picked up: dashboard -> System check -> the From column should
# read "env file" for anything you set here.

# --- capture -----------------------------------------------------------------
# Concurrent DVR connections, shared by all venues. 4 was measured to drop.
STRIKEE_MAX_STREAMS=2
STRIKEE_RATE_TABLE=13
STRIKEE_RATE_GAMING=5
STRIKEE_RATE_ENTRY=3

# --- gaming screens ----------------------------------------------------------
# A station counts as in use only when someone is there AND its TV is on, for
# stations that have a screen zone drawn (--mode screen). Tune per venue if a
# dark game reads as off, or a lit room reads as on:
# STRIKEE_SCREEN_LUM=90       # brightness that counts as "on"
# STRIKEE_SCREEN_CHANGE=6     # frame-to-frame change that counts as "on"
# STRIKEE_SCREEN_HOLD_TICKS=2 # dark reads a screen is forgiven before the
#                             # station closes (loading screens, dark levels)

# --- images -----------------------------------------------------------
# STRIKEE_LIVE_FRAMES=1       # last annotated frame per camera, shown in the
#                             # dashboard. One file per camera, never uploaded.
# STRIKEE_SNAPSHOT_MAX_MB=2000  # disk budget for evidence images
# STRIKEE_S3_UPLOAD=all       # 'none' to keep images off the cloud entirely

# --- occupancy timing --------------------------------------------------------
# In SECONDS, converted per asset from its own sampling rate. Prefer these over
# the *_TICKS knobs, which mean different durations at different rates.
STRIKEE_EXIT_SEC=120
# STRIKEE_ENTER_SEC=25
# STRIKEE_STILL_SEC=40

# --- models ------------------------------------------------------------------
# STRIKEE_SNOOKER_MODEL=best.pt
# STRIKEE_PERSON_MODEL=yolo11n.pt
#
# If a people camera shows people but detects none, find what works with:
#   python tools/survey_cameras.py --url "...channel={ch}..." --channels 9-12 --sweep
# then put the winner here. In rough order of how often each is the answer:
# STRIKEE_PERSON_IMGSZ=1280      # people far down a room are tiny at the default 640
# STRIKEE_PERSON_ASPECT=16:9     # channel delivers a squeezed (anamorphic) frame
# STRIKEE_PERSON_CLAHE=1         # dim room
# STRIKEE_PERSON_CONF=0.15       # lower bar; more detections, more false ones
# STRIKEE_PERSON_MODEL=yolo11x.pt  # much better at angles, much slower on this CPU

# --- storage -----------------------------------------------------------------
# STRIKEE_DB=strikee.db
# STRIKEE_SNAPSHOT_DIR=snapshots
# Evidence-image size. 80 is about 75 KB per image; OpenCV's default 95 is 160 KB
# for no visible gain. Three images per game, so it roughly halves the bill.
# STRIKEE_SNAPSHOT_QUALITY=80
# Local snapshots older than this are deleted (uploaded copies are kept).
# 0 = never delete, and the disk grows forever.
# STRIKEE_SNAPSHOT_KEEP_DAYS=30
# Writes debug_<venue>.csv - one row per read per asset. On for a field test.
STRIKEE_DEBUG=1

# --- cloud sync (Turso) ------------------------------------------------------
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your-token-here
# STRIKEE_TURSO_SYNC_SEC=15
#
# STRIKEE_SYNC_MODE picks HOW the data gets there:
#
#   push     Local SQLite stays the source of truth and rows are pushed up over
#            HTTP on a timer. Works against any Turso database, needs no libsql
#            client, and the box keeps recording through an internet outage -
#            the next cycle resends from where it stopped. USE THIS unless you
#            know embedded replicas work for your database.
#
#   replica  libsql embedded replica (the default). Neater when available, but
#            needs the /v1 replication endpoints, which many databases do not
#            serve - the symptom is "failed to pull db export status 404".
#            Check with: python tools/turso_check.py <url> <token>
#            Needs: pip install -e ".[turso]"
#
#   off      Local only.
#
# STRIKEE_SYNC_MODE=push
# STRIKEE_SYNC_BATCH=200      # rows per request
# STRIKEE_SYNC_METRICS=       # 1 also pushes metric_samples (~2.4M rows/month)

# --- object storage: evidence snapshots --------------------------------------
# Needs: pip install -e ".[cloud]"
#
# Snapshots are always written locally. Uploading matters when you review them
# from somewhere other than the venue - which is the whole point if you are not
# on site. The stored path IS the object key, so the web app can build a URL (or
# a presigned one) from what is already in the database.
#
# AMAZON S3 (no endpoint - boto3 talks to AWS by default):
# STRIKEE_S3_BUCKET=strikee-snapshots
# AWS_DEFAULT_REGION=ap-south-1          # Mumbai. A REAL region is required.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Cap growth in the bucket itself: S3 -> your bucket -> Management ->
# Lifecycle rule -> expire objects after 90 days. About 13 MB/day is written.
#
# CLOUDFLARE R2 instead (endpoint required, region stays "auto"):
# STRIKEE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STRIKEE_S3_REGION=auto
#
# --- object storage: whole-database backup -----------------------------------
# Turso keeps a live cloud copy; this keeps the whole file, which restores in
# one command and brings back config AND history exactly. Worth having both.
#
# Reuse the snapshot bucket with its own folder:
# STRIKEE_BACKUP_BUCKET=strikee-snapshots
# STRIKEE_BACKUP_PREFIX=db-backup       # -> s3://strikee-snapshots/db-backup/
# STRIKEE_BACKUP_EVERY_MIN=30
# (region, endpoint and credentials are shared with the snapshot settings above)
#
# CAUTION with lifecycle rules: an expiry set on the WHOLE bucket deletes your
# database backups too. Scope the snapshot expiry to the venue-id prefixes, or
# leave db-backup/ out of it. Backups are ~200 KB each; they are not the cost.
#
# Prove a backup is restorable BEFORE you need it:
#   python tools/restore.py --verify

# --- unattended run ----------------------------------------------------------
# Start tracking on boot with no clicks. "all" starts every venue.
# STRIKEE_AUTOSTART_VENUE=all
# STRIKEE_HEADLESS=1
